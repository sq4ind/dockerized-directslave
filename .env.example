###########################################
# DirectSlave Docker Environment Configuration
# Copy this file to .env and customize for your environment
###########################################

# ========================================
# DIRECTSLAVE CORE SETTINGS
# ========================================

# Network binding
# Use * to bind to all interfaces, or specify an IP address
DS_HOST=*

# DirectSlave HTTP port
DS_PORT=2222

# DirectSlave HTTPS port
DS_SSLPORT=2224

# Enable or disable SSL (on/off)
DS_SSL=on

# Debug mode (0=off, 1=on)
# Enable for troubleshooting, disable in production
DS_DEBUG=0

# Background mode (0=foreground, 1=background)
# For Docker, this is managed by entrypoint script
DS_BACKGROUND=1

# ========================================
# CRITICAL SECURITY SETTINGS
# ========================================

# DirectSlave Cookie Encryption Key (DS_AUTH_KEY)
# ================================================
# This is the SECRET KEY used by DirectSlave to encrypt/decrypt session cookies
# for the DirectSlave web interface (not the DirectAdmin API password!)
#
# WHAT IT DOES:
# - Encrypts session cookies when users log into DirectSlave web interface
# - Prevents session hijacking and cookie tampering
# - Validates user sessions on each request
#
# WHY IT'S CRITICAL:
# - Without strong key: attackers can forge cookies and access your system
# - Weak keys are vulnerable to brute-force attacks
# - Each installation must have a UNIQUE key
#
# REQUIREMENTS:
# - Minimum: 64 random characters
# - Recommended: 128+ random characters
# - Must include letters, numbers, and symbols
# - Must be cryptographically random
#
# GENERATE STRONG KEY:
#   openssl rand -base64 96
#
# IMPORTANT:
# - Never use the example value below!
# - Never commit real key to version control
# - Change immediately if compromised
# - Use different keys for dev/staging/production
#
DS_AUTH_KEY=CHANGE_ME_TO_A_VERY_LONG_RANDOM_STRING_128_CHARS_OR_MORE!!!

# ========================================
# SSL/TLS CERTIFICATE SETTINGS (CERTBOT)
# ========================================

# Enable automatic SSL certificate generation via Certbot
# Set to true to automatically generate Let's Encrypt certificates
CERTBOT_ENABLED=true

# Email address for Let's Encrypt registration and renewal notifications
# REQUIRED if CERTBOT_ENABLED=true
CERTBOT_EMAIL=admin@example.com

# Domain name for SSL certificate
# This should be the FQDN that points to your DirectSlave server
# REQUIRED if CERTBOT_ENABLED=true
CERTBOT_DOMAIN=dns.example.com

# Certbot validation method
# Options: http (HTTP-01 validation - requires port 80)
CERTBOT_METHOD=http

# ========================================
# BIND/DNS CONFIGURATION
# ========================================

# Directory where DNS zone files will be stored
NAMED_WORKDIR=/etc/namedb/secondary

# Path to BIND configuration file (managed by DirectSlave)
BIND_CONF_PATH=/etc/namedb/secondary/named.conf

# DNS retry time (seconds)
RETRY_TIME=1200

# Path to rndc binary
RNDC_PATH=/usr/sbin/rndc

# Named zone file format (text or binary)
NAMED_FORMAT=text

# ========================================
# USER/GROUP CONFIGURATION
# ========================================

# User ID for DirectSlave and BIND processes
# Default: 53 (standard bind user)
DS_UID=53

# Group ID for DirectSlave and BIND processes
# Default: 53 (standard bind group)
DS_GID=53

# ========================================
# DIRECTADMIN INTEGRATION
# ========================================

# IP address of your master DirectAdmin server
# This is for documentation purposes - configure in DirectAdmin web interface
DIRECTADMIN_IP=192.168.1.100

# DirectAdmin MultiServer API port
# Default is usually 2222
DIRECTADMIN_PORT=2222

# ========================================
# TIMEZONE
# ========================================

# Container timezone (optional)
TZ=UTC

# ========================================
# NOTES
# ========================================
#
# 1. SSL Certificate Requirements:
#    - Port 80 must be accessible from the internet for HTTP-01 validation
#    - Domain (CERTBOT_DOMAIN) must point to this server's IP address
#    - First certificate generation happens during container startup
#    - Certificates auto-renew every 60 days
#
# 2. DirectAdmin Setup:
#    - Enable MultiServer feature in DirectAdmin
#    - Add this server as a slave/secondary DNS server
#    - Use authentication credentials set in DirectSlave
#    - Default credentials can be set via: docker exec -it directslave /usr/local/directslave/bin/directslave --password admin:yourpassword
#
# 3. Port Requirements:
#    - 2222: DirectSlave HTTP interface (for DirectAdmin communication)
#    - 2224: DirectSlave HTTPS interface (secure communication)
#    - 53: DNS queries (UDP and TCP)
#    - 80: Let's Encrypt HTTP-01 validation (only during cert generation/renewal)
#
# 4. First Time Setup:
#    a. Copy this file: cp .env.example .env
#    b. Edit .env and set your values (especially DS_AUTH_KEY, CERTBOT_EMAIL, CERTBOT_DOMAIN)
#    c. Run: docker-compose up -d
#    d. Set DirectSlave password: docker exec -it directslave /usr/local/directslave/bin/directslave --password admin:yourpassword
#    e. Configure DirectAdmin to use this slave DNS server
#
# 5. Security Best Practices:
#    - Never commit .env file to version control
#    - Use strong, unique DS_AUTH_KEY (128+ characters)
#    - Restrict firewall access to ports 2222/2224 (only from DirectAdmin server)
#    - Keep port 53 open for DNS queries from internet
#    - Use HTTPS (port 2224) for DirectAdmin communication when possible
#
# 6. Troubleshooting:
#    - View logs: docker logs directslave
#    - Check DirectSlave logs: docker exec directslave tail -f /usr/local/directslave/log/action.log
#    - Validate config: docker exec directslave /usr/local/bin/validate-config.sh
#    - Test DNS: dig @localhost example.com
#    - Check BIND: docker exec directslave rndc status
