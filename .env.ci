###########################################
# DirectSlave Docker - CI Environment File
# Used by GitHub Actions for docker-compose validation
# Contains safe dummy values only - no secrets
###########################################

# Core settings
DS_HOST=*
DS_PORT=2222
DS_SSLPORT=2224
DS_SSL=on
DS_DEBUG=0
DS_BACKGROUND=1

# Auth key (dummy value for CI validation only)
DS_AUTH_KEY=ci-test-dummy-key-not-for-production-use-replace-with-real-key

# SSL/Certbot (disabled in CI)
CERTBOT_ENABLED=false
CERTBOT_EMAIL=ci@example.com
CERTBOT_DOMAIN=ci.example.com
CERTBOT_METHOD=http

# BIND/DNS
NAMED_WORKDIR=/etc/namedb/secondary
BIND_CONF_PATH=/etc/namedb/secondary/named.conf
RETRY_TIME=1200
RNDC_PATH=/usr/sbin/rndc
NAMED_FORMAT=text

# User/Group
DS_UID=53
DS_GID=53

# Timezone
TZ=UTC
